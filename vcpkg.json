{
    "name": "plasma",
    "version-string": "2.0.70.2",
    "description": "Cyan Worlds' Plasma game engine",
    "dependencies": [
      "asio",
      "curl",
      "expat",
      {
        "name": "fontconfig",
        "platform": "!(osx | windows)"
      },
      "freetype",
      {
        "name": "libarchive",
        "platform": "osx"
      },
      "libepoxy",
      "libjpeg-turbo",
      "libogg",
      "libpng",
      "libvorbis",
      "libvpx",
      "libwebm",
      {
        "name": "openal-soft",
        "features": [
          {
            "name": "pipewire",
            "platform": "linux"
          }
        ]
      },
      "openssl",
      "opus",
      "physx",
      {
        "name": "python3",
        "features": [
          "deprecated-win7-support"
        ]
      },
      "speex",
      "string-theory",
      {
        "name": "libuuid",
        "platform": "linux"
      },
      "tl-expected",
      "zlib"
    ],
    "overrides": [
      {
        "name": "physx",
        "version": "4.1.2#7",
        "$comment": "Upstream vcpkg updated to PhysX 5, which drops support for several target platforms. Stick with 4.1.2 for now."
      },
      {
        "name": "openal-soft",
        "version": "1.24.3#1",
        "$comment": "1.25.x causes a bunch of compiler issues on multiple platforms :("
      },
      {
        "name": "fmt",
        "version": "11.0.2#1",
        "$comment": "Needed by openal-soft, and newer versions broke compatibility"
      }
    ],
    "features": {
      "cairosvg": {
        "description": "Installs a functional cairosvg Python module for the resource.dat generator.",
        "dependencies": [
          {
            "name": "python3-cairosvg",
            "host": true,
            "platform": "!(windows & arm64)"
          }
        ]
      }
    },
    "builtin-baseline": "9e593bb18ea69cc5095e012465dcd675a822ed0d",
    "vcpkg-configuration": {
      "overlay-ports": ["./Scripts/Ports"],
      "overlay-triplets": ["./Scripts/Triplets"]
    }
}
