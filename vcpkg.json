{
    "name": "plasma",
    "version-string": "2.0.70.2",
    "description": "Cyan Worlds' Plasma game engine",
    "dependencies": [
      "asio",
      "curl",
      "expat",
      {
        "name": "fontconfig",
        "platform": "!(osx | windows)"
      },
      "freetype",
      {
        "name": "libarchive",
        "platform": "osx"
      },
      "libepoxy",
      "libjpeg-turbo",
      "libogg",
      "libpng",
      "libvorbis",
      "libvpx",
      "libwebm",
      {
        "name": "openal-soft",
        "features": [
          {
            "name": "pipewire",
            "platform": "linux"
          }
        ]
      },
      "openssl",
      "opus",
      "physx",
      {
        "name": "sdl3",
        "default-features": false,
        "features": [
          "vulkan",
          "wayland",
          "x11"
        ],
        "platform": "!(windows | osx)",
        "$comment": "Windowing and input for the Unix client frontend. We skip the ibus IME feature; the engine does its own text input."
      },
      {
        "name": "dbus",
        "default-features": false,
        "platform": "!(windows | osx)",
        "$comment": "Pulled in by sdl3. Stated here to keep the systemd default feature off, since libsystemd does not build in vcpkg."
      },
      {
        "name": "volk",
        "platform": "linux",
        "$comment": "Vulkan entry point loader for the Vulkan rendering pipeline."
      },
      {
        "name": "vulkan-memory-allocator",
        "platform": "linux"
      },
      {
        "name": "python3",
        "features": [
          "deprecated-win7-support"
        ]
      },
      "speex",
      "string-theory",
      {
        "name": "libuuid",
        "platform": "linux"
      },
      "tl-expected",
      "zlib"
    ],
    "overrides": [
      {
        "name": "physx",
        "version": "4.1.2#7",
        "$comment": "Upstream vcpkg updated to PhysX 5, which drops support for several target platforms. Stick with 4.1.2 for now."
      }
    ],
    "features": {
      "cairosvg": {
        "description": "Installs a functional cairosvg Python module for the resource.dat generator.",
        "dependencies": [
          {
            "name": "python3-cairosvg",
            "host": true,
            "platform": "!(windows & arm64)"
          }
        ]
      }
    },
    "builtin-baseline": "dd3097e305afa53f7b4312371f62058d2e665320",
    "vcpkg-configuration": {
      "overlay-ports": ["./Scripts/Ports"],
      "overlay-triplets": ["./Scripts/Triplets"]
    }
}
